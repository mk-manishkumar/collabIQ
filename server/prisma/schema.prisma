generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())

  // Clerk
  clerkId     String   @unique
  email       String   @unique

  // Profile
  username    String?  @unique
  fullName    String?
  bio         String?
  avatarUrl   String?

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}